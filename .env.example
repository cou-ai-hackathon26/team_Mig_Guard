# LLM & Vision Providers
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
OCR_TIMEOUT_SECONDS=20
EXPLAIN_WITH_LLM=false

# Text-to-Speech (Bangla)
TTS_PROVIDER=edge
TTS_VOICE=bn-BD-NabanitaNeural

# Backend & App Config
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=8
RATE_LIMIT_PER_MINUTE=30
LLM_DAILY_CALL_LIMIT=100
LLM_DAILY_COST_LIMIT_USD=5
LLM_ESTIMATED_COST_USD=0.01